#!/bin/sh
# Conventional Commits, and no assistant attribution. Both are structural here:
# a message that fails this never becomes a git object.
set -eu

MSG_FILE=$1
SUBJECT=$(sed -n '1p' "$MSG_FILE")

# Merges, reverts and fixups are generated by git; leave them alone.
case "$SUBJECT" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

PATTERN='^(feat|fix|chore|docs|perf|refactor|test|build|ci|style|revert)(\([a-z0-9._/-]+\))?!?: .+'
if ! printf '%s' "$SUBJECT" | grep -Eq "$PATTERN"; then
  echo "commit-msg: not a Conventional Commit." >&2
  echo "  got:      $SUBJECT" >&2
  echo "  expected: type(scope)!: subject" >&2
  echo "  types:    feat fix chore docs perf refactor test build ci style revert" >&2
  exit 1
fi

if [ "${#SUBJECT}" -gt 72 ]; then
  echo "commit-msg: subject is ${#SUBJECT} characters; keep it to 72." >&2
  exit 1
fi

case "$SUBJECT" in
  *.) echo "commit-msg: subject must not end with a period." >&2; exit 1 ;;
esac

# The work is published under the owner's name.
if grep -Eiq '(co-authored-by:.*(claude|copilot|chatgpt|gpt|gemini|cursor|codex|anthropic|openai))|(generated with)|(🤖)|(authored by an ai)|(assisted by ai)' "$MSG_FILE"; then
  echo "commit-msg: remove assistant attribution from the commit message." >&2
  exit 1
fi
