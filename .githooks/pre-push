#!/bin/sh
# The last gate before code leaves the machine.
#
# git feeds us one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>
# A remote sha of all zeros means the remote branch does not exist yet.
set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

ZERO=0000000000000000000000000000000000000000

DEFAULT=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||') || true
[ -z "${DEFAULT:-}" ] && DEFAULT=main

blocked=0
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue

  # Deleting a ref: nothing to check.
  [ "$local_sha" = "$ZERO" ] && continue

  case "$remote_ref" in
    "refs/heads/$DEFAULT")
      if [ "$remote_sha" = "$ZERO" ]; then
        # First publication of the default branch. There is no pull request to
        # come through, because there is no branch yet.
        echo "pre-push: publishing $DEFAULT for the first time"
      else
        echo "pre-push: $DEFAULT only advances through a merged pull request." >&2
        echo "  start work with: scripts/agent start <type>/<slug>" >&2
        blocked=1
      fi
      ;;
  esac
done

[ "$blocked" -eq 0 ] || exit 1

echo "pre-push: running scripts/task check"
scripts/task check
