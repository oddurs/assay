  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.70.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddurs/assay.git"
  },
  "bugs": {
    "url": "https://github.com/oddurs/assay/issues"
  },
  "homepage": "https://oddurs.github.io/assay/",
  "author": "Oddur Sigurdsson"
