{
  "name": "assay",
  "type": "module",
  "description": "Compile-time design system conformance for StyleX. Tells you what your design system actually shipped.",
  "scripts": {
    "test": "node test/run.mjs",
    "assay": "node bin/assay.js",
    "check": "scripts/task check"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0"
  },
  "version": "0.2.0",
  "license": "MIT",
  "bin": {
    "assay": "./bin/assay.js"
  },
  "main": "./src/index.js",
  "exports": {
