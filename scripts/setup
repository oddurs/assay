#!/bin/sh
# One command to a working checkout. Run once after cloning.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

echo "→ installing dependencies"
npm ci --no-audit --no-fund

echo "→ pointing git at the tracked hooks"
git config core.hooksPath .githooks

# The site imports a report the tool generates. It is not tracked, so a fresh
# clone has none — produce it here rather than leaving a broken import until
# somebody's first build.
echo "→ generating the site's measured report"
node site/scripts/assay-report.mjs >/dev/null

echo
echo "Ready. Next:"
echo "  scripts/task check          run everything CI runs"
echo "  scripts/agent start feat/x  begin a unit of work"
