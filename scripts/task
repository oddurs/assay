#!/bin/sh
# The stack seam.
#
# CI, the git hooks and scripts/agent all talk to the project through this file
# and nothing else. Nothing outside it knows that this project is JavaScript, or
# that the site is built with Vite. Change toolchain here, once.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

usage() {
  cat <<'USAGE'
usage: scripts/task <target>

  fmt         format in place
  fmt:check   verify formatting, non-zero on drift
  lint        lint; warnings are errors
  types       typecheck; vite build does not do this for you
  size        enforce the bundle budget on packages that ship to users
  test        the tool's test suite, plus the site's own conformance gate
  build       build the site (also regenerates its measured report)
  check       fmt:check && lint && types && test && build
  new <name>  scaffold a new package under packages/
USAGE
}

# The site imports a report this tool generates. It is not tracked, so a clean
# checkout has none — and typechecking a file that imports it fails without it.
ensure_report() {
  node site/scripts/assay-report.mjs >/dev/null
}

need_deps() {
  if [ ! -d node_modules ]; then
    echo "dependencies are missing; run scripts/setup" >&2
    exit 1
  fi
}

case "${1:-}" in
  fmt)
    npx --no-install prettier --write .
    ;;
  fmt:check)
    npx --no-install prettier --check .
    ;;
  lint)
    npx --no-install eslint . --max-warnings=0 --no-warn-ignored
    ;;
  types)
    # `vite build` does not typecheck. Without this, a type error reaches main.
    need_deps
    ensure_report
    npx --no-install tsc --noEmit --project site/tsconfig.json
    # The variants package ships types as its feature, so they are tested.
    npx --no-install tsc --noEmit --project packages/variants/types-test/tsconfig.json
    ;;
  size)
    # `variants` is the only package that enters a user's production bundle.
    # A budget is the difference between meaning that and merely saying it.
    need_deps
    budget=4096
    actual=$(cat packages/variants/src/index.js | wc -c | tr -d ' ')
    if [ "$actual" -gt "$budget" ]; then
      echo "size: packages/variants is ${actual}B, over the ${budget}B budget" >&2
      exit 1
    fi
    echo "size: packages/variants ${actual}B of ${budget}B"
    ;;
  test)
    need_deps
    node test/run.mjs
    # Dogfooding is not decoration: the site must stay 100% conformant, and the
    # gate that enforces that is part of the test suite, not a separate ritual.
    # It runs against the workspace, so a regression fails here rather than
    # waiting for a release.
    node packages/audit/bin/stylegraph.js site/src
    ;;
  build)
    need_deps
    npm run build --workspace site
    ;;
  new)
    # A new package is four files that must agree with each other. Generating
    # them removes the chance of a manifest that says one thing and a README
    # that says another.
    name=${2:-}
    [ -n "$name" ] || { echo "usage: scripts/task new <package-name>" >&2; exit 2; }
    dir="packages/$name"
    [ -e "$dir" ] && { echo "already exists: $dir" >&2; exit 1; }
    mkdir -p "$dir/src"
    cat > "$dir/package.json" <<JSON
{
  "name": "@stylegraph/$name",
  "version": "0.1.0",
  "description": "TODO: one sentence, in the present tense.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": { ".": "./src/index.js" },
  "files": ["src", "bin", "README.md"],
  "engines": { "node": ">=18" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stylegraphjs/stylegraph.git",
    "directory": "packages/$name"
  },
  "homepage": "https://stylegraph.dev",
  "publishConfig": { "access": "public" },
  "dependencies": { "@stylegraph/spec": "0.1.0" }
}
JSON
    cat > "$dir/src/index.js" <<JS
// Not written yet.
export const NAME = '@stylegraph/$name';
JS
    cat > "$dir/README.md" <<MD
# @stylegraph/$name

TODO: one sentence, in the present tense.

Part of [stylegraph](https://github.com/stylegraphjs/stylegraph) — a specified
graph of every style in a codebase, and the tools that read it.

MIT.
MD
    echo "created $dir — now: npm install, and fill in the description"
    ;;
  check)
    "$0" fmt:check
    "$0" lint
    "$0" types
    "$0" size
    "$0" test
    "$0" build
    ;;
  ''|-h|--help|help)
    usage
    ;;
  *)
    echo "unknown target: $1" >&2
    usage >&2
    exit 2
    ;;
esac
